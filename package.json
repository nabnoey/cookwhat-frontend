{
  "name": "cookwhat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cookwhat/frontend",
    "build": "npm run build --workspace @cookwhat/frontend",
    "start": "npm run start --workspace @cookwhat/frontend",
    "lint": "npm run lint --workspace @cookwhat/frontend",
    "test": "jest --runInBand",
    "test:e2e": "playwright test --config apps/frontend/playwright.config.ts",
    "db:generate": "npm run db:generate --workspace @cookwhat/backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @cookwhat/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @cookwhat/backend",
    "db:seed": "npm run db:seed --workspace @cookwhat/backend",
    "api:dev": "npm run dev --workspace @cookwhat/backend",
    "api:build": "npm run build --workspace @cookwhat/backend",
    "api:start": "npm run start --workspace @cookwhat/backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
}
