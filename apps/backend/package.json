{
  "name": "@cookwhat/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx server/index.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@cookwhat/shared": "0.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.23.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
